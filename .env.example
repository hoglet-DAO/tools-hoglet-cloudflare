NEXT_PUBLIC_RPC_URL_TESTNET=https://rpc-testnet.supra.com
NEXT_PUBLIC_RPC_URL_MAINNET=https://rpc-mainnet.supra.com

NEXT_PUBLIC_ENABLE_SPONSOR_TX=false

# Contract Addresses (Optional, replace with your own if deploying custom contracts)
NEXT_PUBLIC_SUPRA_AMM_ROUTER=0x3045d27b5fada1e30897a741fb184e48ef0bff3717aea23918ebc1e5c7153083
NEXT_PUBLIC_BWSUP_ADDRESS=0x3db05342523bd72817b09f264761a7621eeb21d0960d9676ba5ce14651b17c43

# DAO Contracts Vault: the Resource Account hosting `dao_contracts_vault::vault`.
#
# This MUST equal the `dao_contracts_vault` named address in smart_contract/dao_contracts_vault/Move.toml.
# The module's self address is fixed into its bytecode at compile time, so a mismatch means the deployed
# module sits at one address while the app queries another, and every audit reports "no factory record".
# Leaving it unset falls back to 0x1, which reads as "vault not published" rather than failing.
NEXT_PUBLIC_DAO_CONTRACTS_VAULT=

# Move compile service (compile-only, hosted on the VPS). Compile requests are proxied through
# /api/move/compile so the bearer token never reaches the browser.
#
# MOVE_COMPILE_TOKEN must NOT be prefixed with NEXT_PUBLIC_. Anything marked that way is inlined into the
# client bundle and is readable by anyone who opens devtools.
MOVE_COMPILE_URL=https://move-compile.hoglet.xyz
MOVE_COMPILE_TOKEN=